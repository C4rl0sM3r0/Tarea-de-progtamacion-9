<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="549.0" prefWidth="527.0" spacing="10" styleClass="form-card" stylesheets="@registro-view.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.datasoft.proyectoventas.registro.RegistroController">
   <Label styleClass="form-title" stylesheets="@registro-view.css" text="REGISTRO DE CLIENTES" />

    <GridPane alignment="CENTER" hgap="10" prefHeight="206.0" prefWidth="491.0" styleClass="input-field" stylesheets="@registro-view.css" vgap="10">
        <Label styleClass="input-label" text="Documento" />
        <TextField fx:id="txtDocumento" GridPane.columnIndex="1" />

        <Label styleClass="input-label" text="Apellidos" GridPane.rowIndex="1" />
        <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label styleClass="input-label" text="Nombres" GridPane.rowIndex="2" />
        <TextField fx:id="txtNombres" prefHeight="26.0" prefWidth="113.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label styleClass="input-label" text="Dirección" GridPane.rowIndex="3" />
        <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label styleClass="input-label" text="Género" GridPane.rowIndex="4" />
        <ComboBox fx:id="cbGenero" prefHeight="26.0" prefWidth="151.0" promptText="GENERO" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <HBox spacing="10">
        <Button onAction="#guardar" styleClass="secondary-button" stylesheets="@registro-view.css" text="Guardar" />
        <Button contentDisplay="RIGHT" onAction="#limpiar" prefHeight="26.0" prefWidth="100.0" styleClass="danger-button" stylesheets="@registro-view.css" text="Nuevo" />
    </HBox>

    <TableView fx:id="tabla" prefHeight="202.0" prefWidth="997.0">
        <columns>
            <TableColumn fx:id="colDoc" text="Documento" />
            <TableColumn fx:id="colApe" prefWidth="91.20001983642578" text="Apellidos" />
            <TableColumn fx:id="colNom" prefWidth="96.79998779296875" text="Nombres" />
            <TableColumn fx:id="colDir" prefWidth="138.4000244140625" text="Dirección" />
            <TableColumn fx:id="colGen" minWidth="8.0" prefWidth="115.99996948242188" text="Género" />
        </columns>
    </TableView>

</VBox>
