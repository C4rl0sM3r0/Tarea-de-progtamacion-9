<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.datasoft.proyectoventas.registro.RegistroController">

    <GridPane hgap="10" vgap="10">
        <Label text="Documento"/>
        <TextField fx:id="txtDocumento" GridPane.columnIndex="1"/>

        <Label text="Apellidos" GridPane.rowIndex="1"/>
        <TextField fx:id="txtApellidos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Nombres" GridPane.rowIndex="2"/>
        <TextField fx:id="txtNombres" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Dirección" GridPane.rowIndex="3"/>
        <TextField fx:id="txtDireccion" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Género" GridPane.rowIndex="4"/>
        <ComboBox fx:id="cbGenero" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Guardar" onAction="#guardar"/>
        <Button text="Nuevo" onAction="#limpiar"/>
    </HBox>

    <TableView fx:id="tabla" prefHeight="200">
        <columns>
            <TableColumn fx:id="colDoc" text="Documento"/>
            <TableColumn fx:id="colApe" text="Apellidos"/>
            <TableColumn fx:id="colNom" text="Nombres"/>
            <TableColumn fx:id="colDir" text="Dirección"/>
            <TableColumn fx:id="colGen" text="Género"/>
        </columns>
    </TableView>

</VBox>