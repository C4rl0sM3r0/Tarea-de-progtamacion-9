<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.datasoft.proyectoventas.productos.ProductoController">

    <GridPane hgap="10" vgap="10">
        <Label text="Nombre"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1"/>

        <Label text="Precio" GridPane.rowIndex="1"/>
        <TextField fx:id="txtPrecio" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Descripción" GridPane.rowIndex="2"/>
        <TextArea fx:id="txtDescripcion" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Guardar" onAction="#guardar"/>
        <Button text="Nuevo" onAction="#limpiar"/>
    </HBox>

    <TableView fx:id="tabla" prefHeight="200">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colPrecio" text="Precio"/>
            <TableColumn fx:id="colDescripcion" text="Descripción"/>
        </columns>
    </TableView>

</VBox>